{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "考勤统计",
  "version": "0.3.1",
  "identifier": "com.attendance.tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "考勤统计",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "MichaelChui",
    "copyright": "Copyright © 2026 MichaelChui",
    "targets": ["dmg", "nsis"],
    "resources": ["resources/attendance-engine/"],
    "category": "Productivity",
    "shortDescription": "本地考勤统计与加班调休计算工具",
    "longDescription": "读取员工个人考勤 Excel 报表，按照工作日、节假日、午休及跨日规则统计工时，支持调休分摊和打卡时间修订。",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    },
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
